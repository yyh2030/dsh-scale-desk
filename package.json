{
  "name": "@local/scale-desk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "量表计分：量表库、答题纸录入、外部导入、一键计分与校验，输出 _lab/scores.csv",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "scoring.js",
    "client.js",
    "xlsx_dump.py",
    "study-context.mjs",
    "study-selection.mjs",
    "persistence.mjs",
    "mutation-journal.mjs",
    "sample-study.json",
    "sample-def.json",
    "tests",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:host": "node tests/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "minVersion": "0.2.2-rc.1"
  }
}
